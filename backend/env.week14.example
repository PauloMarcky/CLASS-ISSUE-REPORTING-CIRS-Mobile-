# Copy these lines into backend/.env (never commit .env). Values below are examples only.

# REQUIRED: at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Token lifetime in minutes.
TOKEN_MINUTES=30

# Web origin(s) allowed to call the API (comma separated). Flutter: --web-port=5000
CORS_ORIGINS=http://localhost:5000

# Password hashing cost and lockout policy.
BCRYPT_COST=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Rate limits per IP per window.
RATE_WINDOW_MINUTES=15
API_RATE_LIMIT=300
LOGIN_RATE_LIMIT=10

# HTTPS (used by the HTTPS server step).
TLS_KEY_PATH=
TLS_CERT_PATH=
HTTPS_PORT=3443